# =============================================================
#  Application Configuration (EXAMPLE)
# -------------------------------------------------------------
#  Copy this file to `.env` and fill real values.
#  NEVER commit the real `.env`.
# =============================================================

# ---------- App ----------
APP_NAME="Appointment Booking System"
APP_VERSION="1.0.0"
DEBUG=True

# ---------- Database ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_db"

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="replace-me-with-a-64-char-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- External API (WorldTimeAPI — no key needed) ----------
EXTERNAL_API_URL="http://worldtimeapi.org/api/timezone/Etc/UTC"
EXTERNAL_API_TIMEOUT=3

# Admin seed (used by scripts/seed_admin.py)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="adminpass123"